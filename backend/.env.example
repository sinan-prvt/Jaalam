# Copy to backend/.env for local development (backend/.env is git-ignored).
# Local `manage.py` commands default to DEBUG=True with a development SECRET_KEY,
# so everything below is optional locally. In production all of it must be set.

# DEBUG=False
# SECRET_KEY=change-me-to-a-long-random-string
# DATABASE_URL=postgres://user:password@host:5432/dbname

# Razorpay (test keys from https://dashboard.razorpay.com/app/keys)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Optional: webhook signing secret (activates plans even if the buyer closes the browser)
RAZORPAY_WEBHOOK_SECRET=

# Extra browser origins allowed to call the API directly (comma separated).
# Not needed when the frontend proxies /api through its own domain.
# FRONTEND_ORIGINS=https://jaalam.app,https://www.jaalam.app

# Public frontend address for emailed links (password reset). Locally it falls back to http://localhost:5173.
# FRONTEND_URL=https://jaalam.app

# SMTP for real emails; without EMAIL_HOST, emails are printed to the console.
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
# EMAIL_HOST_USER=you@gmail.com
# EMAIL_HOST_PASSWORD=app-password
# DEFAULT_FROM_EMAIL=Jaalam <you@gmail.com>

# Photo/music storage on S3-compatible object storage (Cloudflare R2 shown). Without a bucket,
# uploads stay in backend/media/ (fine locally; on Render they are lost at every deploy).
# After configuring, copy existing uploads once: python manage.py move_media_to_storage
# AWS_STORAGE_BUCKET_NAME=jaalam-media
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_S3_ENDPOINT_URL=https://<account-id>.r2.cloudflarestorage.com
# AWS_S3_CUSTOM_DOMAIN=pub-xxxxxxxx.r2.dev
